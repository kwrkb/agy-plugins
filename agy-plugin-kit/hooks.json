{
  "agy-plugin-kit-validator": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "validator/bin/validator --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "validator/bin/validator --inject",
        "timeout": 10
      }
    ]
  }
}
